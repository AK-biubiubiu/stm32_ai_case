{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (DAP-Link / OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/stm32_mnist_ai.elf",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32f1x.cfg"
      ],
      "openocdPath": "${config:openocdPath}",
      "armToolchainPath": "${config:armToolchainPath}",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "preLaunchTask": "build debug"
    },
    {
      "name": "Attach (DAP-Link / OpenOCD)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/stm32_mnist_ai.elf",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32f1x.cfg"
      ],
      "openocdPath": "${config:openocdPath}",
      "armToolchainPath": "${config:armToolchainPath}"
    }
  ]
}
